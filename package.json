{
  "name": "substream-backend",
  "version": "1.0.0",
  "description": "API for SubStream Protocol",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main",
    "start:ws": "nest start",
    "start:ws:dev": "nest start --watch",
    "start:ws:debug": "nest start --debug --watch",
    "start:ws:prod": "node dist/main",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "soroban": "node worker.js --soroban",
    "soroban:dev": "nodemon worker.js --soroban",
    "soroban:health": "node worker.js --soroban --health",
    "reconciliation": "node worker.js --reconciliation",
    "reconciliation:dev": "nodemon worker.js --reconciliation",
    "reconciliation:health": "node worker.js --reconciliation --health",
    "pii-scrub": "node workers/piiScrubbingWorker.js",
    "pii-scrub:dry-run": "node workers/piiScrubbingWorker.js 3 --dry-run",
    "subscription-worker": "node workers/sorobanSubscriptionWorker.js",
    "subscription-worker:dev": "nodemon workers/sorobanSubscriptionWorker.js",
    "subscription-worker:health": "node workers/sorobanSubscriptionWorker.js --health",
    "test:soroban": "jest --testPathPattern=soroban",
    "test:pii": "jest piiScrubbing.test.js",
    "migrate": "node migrations/runMigrations.js",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "migrate:list": "knex migrate:list",
    "migrate:up": "knex migrate:up",
    "migrate:down": "knex migrate:down",
    "migrate:zero-downtime": "node scripts/zero_downtime_migration_tool.js",
    "migrate:test": "node scripts/zero_downtime_migration_tool.js test",
    "migrate:wizard": "node scripts/zero_downtime_migration_tool.js wizard",
    "health-check": "node migrations/healthChecker.js",
    "swagger:generate": "GENERATE_SWAGGER=true node -e \"require('./src/utils/swaggerGenerator').generateSwagger()\"",
    "dev": "concurrently \"npm run start:dev\" \"npm run worker:dev\"",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "sync:historical": "ts-node scripts/sync-historical.ts",
    "sync:historical:prod": "node dist/scripts/sync-historical.js",
    "test": "jest",
    "docs": "npm run swagger:generate && echo 'Documentation available at http://localhost:3000/api/docs'"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/testing": "^11.1.26",
    "@nestjs/websockets": "^11.1.26",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@sendgrid/mail": "^8.1.0",
    "@sentry/node": "^10.57.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@types/node": "^25.9.3",
    "amqplib": "^2.0.1",
    "apollo-datasource": "^3.3.2",
    "apollo-server-express": "^3.13.0",
    "archiver": "^8.0.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.1",
    "bull": "^4.12.2",
    "bullmq": "^5.78.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.0.0",
    "cors": "^2.8.6",
    "csv-writer": "^1.6.0",
    "dataloader": "^2.2.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.6",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "ip-range-check": "^0.2.0",
    "ipfs-http-client": "^60.0.1",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "multer": "^2.1.1",
    "node-forge": "^1.4.0",
    "node-vault": "^0.12.0",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.1.0",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^6.0.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "soroban-client": "^1.0.0",
    "stripe": "^22.2.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "web3.storage": "^4.5.4",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/bcrypt": "^6.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^30.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
